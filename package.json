{
  "name": "exaroton-telegram-bot",
  "version": "0.1.0",
  "description": "Production-quality, multi-tenant Telegram bot for monitoring exaroton servers.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "format": "prettier --write src"
  },
  "dependencies": {
    "grammy": "^1.46.0",
    "better-sqlite3": "^13.0.3",
    "ws": "^8.22.0",
    "dotenv": "^1.0.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.10",
    "@types/node": "^20.12.12",
    "@types/ws": "^8.5.10",
    "typescript": "^5.4.5",
    "tsx": "^4.11.0",
    "vitest": "^1.6.0",
    "eslint": "^9.3.0",
    "typescript-eslint": "^8.0.0", 
    "prettier": "^3.2.5"
  }
}